# Lakebase Postgres (Neon pooled connection string)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Neon Auth (Managed Better Auth)
NEON_AUTH_BASE_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth/.well-known/jwks.json
NEON_AUTH_COOKIE_SECRET=replace-with-openssl-rand-base64-32

# Single-owner lock (optional in local dev; REQUIRED in production)
# Only this email can access private routes and APIs once set.
OWNER_EMAIL=

# Local/E2E bypass (NEVER set to true in production)
DEV_AUTH_BYPASS=false

# Neon Object Storage (S3-compatible private bucket)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-1
SPELL_MEDIA_BUCKET=spell-media

# Public Catalog CORS Origin
PUBLIC_CATALOG_ORIGINS=https://tarotdeluna.netlify.app,http://localhost:5173

# Optional Netlify Build Hook URL (triggers automatic site rebuild when clicking "Subir a Netlify")
NETLIFY_BUILD_HOOK_URL=
